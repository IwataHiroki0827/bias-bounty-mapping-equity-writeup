# このファイルをコピーして .env を作り、値を入れる(.env は .gitignore 済み。コミットされない)
#   sh scripts/setup.sh   (または cp .env.example .env)
# 書き方: KEY=値。引用符は不要。行末コメントは「 #」(空白+#)の後ろが無視される。
# このファイル(.env.example)には値を書かない。キー名だけを置く。

# Kaggle: 推奨は新方式のアクセストークン(kaggle.json は使わない)
#   KGAT_ トークンは約1時間で失効する。提出直前に更新する:
#   KAGGLE_API_TOKEN=$(python -m kaggle auth print-access-token)
KAGGLE_API_TOKEN=
# Kaggle 旧方式(必要なときだけ)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face(public リポのDLだけなら不要。失効トークンがあると public でも 401 になる)
HF_TOKEN=

# 実験管理(任意)
WANDB_API_KEY=

# その他のプラットフォーム・LLM API(使うものだけ)
SIGNATE_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SIGNATE ログイン情報
SIGNETE_USER=
SIGNETE_PASS=

# Zindi ログイン情報
ZINDI_USR=
ZINDI_PASSWORD=
